<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Cosmos.TestingFramework/build/Cosmos.TestingFramework.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Run the whole protocol suite once per NIC driver, two cells per arch:
       E1000E and virtio-net-pci on x64, virtio-net over MMIO and over PCI on
       arm64. This is the data-path coverage for the virtio drivers —
       DHCP/UDP/TCP/DNS over their rings — as opposed to the Virtio suite,
       which only proves the devices bind.

       Both transports now run on both arches, so a regression in the shared
       virtio code has to survive four independent protocol runs, and the two
       PCI cells differ exactly in their MSI backend (LAPIC vs GICv3 ITS). -->
  <ItemGroup>
    <CosmosTestProfile Include="e1000e" />
    <CosmosTestProfile Include="virtio-net-pci" />
    <CosmosTestProfile Include="virtio-net-mmio" />
  </ItemGroup>

  <!-- Core kernel packages (using project references for development) -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" />
    <PackageReference Include="Cosmos.Kernel.System" />
    <ProjectReference Include="../../Cosmos.TestingFramework/Cosmos.TestingFramework.csproj" />
  </ItemGroup>

  <Import Project="../../Cosmos.TestingFramework/build/Cosmos.TestingFramework.targets" />
</Project>
