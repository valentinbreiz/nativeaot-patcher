<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Cosmos.TestingFramework/build/Cosmos.TestingFramework.props" />

  <Sdk Name="Cosmos.Sdk" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- Transport is a property of the cell, not of the architecture. x64 has
       only the PCI cell (q35 has no virtio-mmio window), while arm64 runs
       both: MMIO through the virt machine's window, and PCI through its PCIe
       bridge. Every cell attaches a NIC plus a keyboard and mouse so network
       and input binding are covered on each transport.

       The arm64 PCI cell is the one that earns its keep: it is the only place
       the PCI transport meets a non-LAPIC MSI backend (GICv3 ITS). -->
  <ItemGroup>
    <CosmosTestProfile Include="virtio-pci" />
    <CosmosTestProfile Include="virtio-mmio" />
  </ItemGroup>

  <!-- Core kernel packages (using project references for development) -->
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" />
    <PackageReference Include="Cosmos.Kernel.System" />
    <ProjectReference Include="../../Cosmos.TestingFramework/Cosmos.TestingFramework.csproj" />
  </ItemGroup>
  <Import Project="../../Cosmos.TestingFramework/build/Cosmos.TestingFramework.targets" />
</Project>
