<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../Cosmos.TestingFramework/build/Cosmos.TestingFramework.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>


  <!-- Hardware matrix (tests/profiles.json): `bare` keeps the default-adapter
       run (GOP over stdvga VBE on x64, ramfb on arm64); `vmware-svga` swaps in
       the VMware SVGA II adapter — the display still runs GOP over the
       device's embedded Bochs VBE core, and the Svga3D_* FIFO tests bind the
       SvgaIIDriver to the adapter without enabling it. -->
  <ItemGroup>
    <CosmosTestProfile Include="bare" />
    <CosmosTestProfile Include="vmware-svga" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Cosmos.Kernel" />
    <PackageReference Include="Cosmos.Kernel.System" />
    <ProjectReference Include="../../Cosmos.TestingFramework/Cosmos.TestingFramework.csproj" />
  </ItemGroup>

  <Import Project="../../Cosmos.TestingFramework/build/Cosmos.TestingFramework.targets" />
</Project>
