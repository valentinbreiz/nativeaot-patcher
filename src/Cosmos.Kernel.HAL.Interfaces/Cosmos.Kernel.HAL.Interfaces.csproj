<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Public surface tracked in PublicAPI.Shipped/Unshipped.txt (see Directory.Build.props):
             the device contracts a kernel can obtain one of and pass to the ring
             (IBlockDevice, INetworkDevice), plus SoftwareTimer and MACAddress. -->
        <CosmosTrackPublicApi>true</CosmosTrackPublicApi>
    </PropertyGroup>

    <ItemGroup>
        <!-- The rest are internal because no kernel can obtain or meaningfully
             supply one: the boot contract (IPlatformInitializer), IGraphicDevice,
             and the input and timer devices, whose only registration callers are
             System's own LibraryInitializer wiring up HAL enumeration. -->
        <InternalsVisibleTo Include="Cosmos.Kernel.HAL" />
        <InternalsVisibleTo Include="Cosmos.Kernel.HAL.X64" />
        <InternalsVisibleTo Include="Cosmos.Kernel.HAL.ARM64" />
        <!-- The aggregator's and System's library initializers read
             PlatformHAL.Initializer during boot, through var. -->
        <InternalsVisibleTo Include="Cosmos.Kernel" />
        <InternalsVisibleTo Include="Cosmos.Kernel.System" />
        <!-- The white-box storage suite maps a high BAR through
             PlatformHAL.Initializer.EnsureMmioMapped, and the virtio suite
             holds the enumerated input devices it exercises. -->
        <InternalsVisibleTo Include="Cosmos.Kernel.Tests.Storage" />
        <InternalsVisibleTo Include="Cosmos.Kernel.Tests.Virtio" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Cosmos.Build.API\Cosmos.Build.API.csproj" />
        <ProjectReference Include="..\Cosmos.Kernel.Core\Cosmos.Kernel.Core.csproj" />
        <ProjectReference Include="..\Cosmos.Build.Analyzer.Patcher\Cosmos.Build.Analyzer.Patcher.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
